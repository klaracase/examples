          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "klaracase API token"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ Object.values($json.sections).flat().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000001-0000-4000-8000-000000000005",
      "name": "Any hits?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        680,
        100
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "d1",
              "name": "draftSubject",
              "type": "string",
              "value": "=Re: {{ $('Mail').item.json.Subject }}"
            },
            {
              "id": "d2",
              "name": "draftText",
              "type": "string",
              "value": "=Mögliche Fundstellen (bitte jeweils im Volltext prüfen, die Gültigkeit wird nicht geprüft):\n\n{{ Object.values($json.sections).flat().map(h => '- ' + h.fundstelle + '\\n  ' + h.corpus_url).join('\\n') }}"
            },
            {
              "id": "d3",
              "name": "labelName",
              "type": "string",
              "value": "klaracase-geprüft"
            }
          ]
        },
        "options": {}
