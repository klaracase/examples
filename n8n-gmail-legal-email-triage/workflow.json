        }
      }
    },
    {
      "parameters": {
        "url": "https://klaracase.de/api/v1/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ $json.Subject.slice(0, 500) }}"
            },
            {
              "name": "limit",
              "value": "3"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000001-0000-4000-8000-000000000004",
